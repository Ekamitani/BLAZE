      "program": "${workspaceFolder}/vision/cylinders_detect/classic_vision/_runtime_classico_v2_core.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
